<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="insert-all-world-countries-csv" author="admin">
        <loadData tableName="countries"
                  file="db/changelog/data/countries.csv"
                  relativeToChangelogFile="false">
            <column name="id" type="UUID"/>
            <column name="name" type="STRING"/>
            <column name="continent" type="STRING"/>
            <column name="flag" type="STRING"/>
        </loadData>
    </changeSet>

    <changeSet id="insert-all-world-denominations-csv" author="admin">
        <loadData tableName="denominations"
                  file="db/changelog/data/denominations.csv"
                  relativeToChangelogFile="false">
            <column name="id" type="UUID"/>
            <column name="title" type="STRING"/>
            <column name="country_id" type="UUID"/>
        </loadData>
    </changeSet>

    <changeSet id="add-all-languages" author="admin">
        <insert tableName="languages">
            <column name="id" value="2365214c-c174-4403-9a5c-00501dc4f465"/>
            <column name="name" value="Limba Română"/>
            <column name="country_id" value="4b66d81f-65d4-438b-8036-17058d420a4b"/>
        </insert>
        <insert tableName="languages">
            <column name="id" value="d59d8ec4-9dcd-4fe4-bd71-28e88be34f08"/>
            <column name="name" value="English"/>
            <column name="country_id" value="e216a43a-6378-4fc4-a5bc-10a8907f4222"/>
        </insert>
    </changeSet>

</databaseChangeLog>